{
  "name": "news-ingestion",
  "version": "1.0.0",
  "description": "Node.js ingestion pipeline foundation (scraping and publishing will be added later).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "scraper": "ts-node src/core/scheduler.ts",
    "run:run1": "ts-node src/core/runFetcherOnce.ts --run=run1",
    "run:run2": "ts-node src/core/runFetcherOnce.ts --run=run2",
    "run:run3": "ts-node src/core/runFetcherOnce.ts --run=run3",
    "run:run4": "ts-node src/core/runFetcherOnce.ts --run=run4",
    "fetcher:run": "ts-node src/core/runFetcherOnce.ts",
    "fetcher:run:dry-run": "FETCHER_DRY_RUN=true ts-node src/core/runFetcherOnce.ts",
    "fetcher:verify": "ts-node src/scripts/verifyFetcherWorker.ts",
    "sync-categories": "ts-node src/scripts/categoryFetcher.ts",
    "sync-tags": "ts-node src/scripts/tagFetcher.ts",
    "sync-authors": "ts-node src/scripts/authorFetcher.ts",
    "sync-all": "ts-node src/scripts/syncAll.ts",
    "audit:scrape": "ts-node src/scripts/auditScrape.ts",
    "normalize:audit-output": "ts-node src/scripts/normalizeAuditOutput.ts",
    "candidates:dry-run": "ts-node src/scripts/insertNormalizedCandidates.ts",
    "candidates:insert": "ts-node src/scripts/insertNormalizedCandidates.ts --insert",
    "candidates:verify": "ts-node src/scripts/verifyStep2.ts",
    "scraper:inspect": "ts-node src/scripts/inspectScraper.ts",
    "ai:process-pending": "ts-node src/scripts/processPendingCandidates.ts",
    "ai:process-pending:dry-run": "ts-node src/scripts/processPendingCandidates.ts --dry-run",
    "ai:verify": "ts-node src/scripts/verifyStep3.ts",
    "gunner:create-drafts": "ts-node src/scripts/createSanityDraftsFromProcessed.ts",
    "gunner:create-drafts:dry-run": "ts-node src/scripts/createSanityDraftsFromProcessed.ts --dry-run",
    "gunner:verify": "ts-node src/scripts/verifyStep4.ts",
    "batch:verify": "ts-node src/scripts/verifyBatchOrchestration.ts",
    "pipeline:dry-run": "FETCHER_DRY_RUN=true FETCHER_WRITE_ENABLED=false FETCHER_MAX_TOTAL_ARTICLES=3 npm run run:run1 && AI_PROVIDER=mock AI_DRY_RUN=true AI_PROCESS_LIMIT=1 npm run ai:process-pending:dry-run && GUNNER_WRITE_ENABLED=false GUNNER_LIMIT=1 npm run gunner:create-drafts:dry-run",
    "db:verify-batch-migration": "ts-node src/scripts/verifyBatchMigration.ts",
    "github:outputs:fetcher": "ts-node src/scripts/emitFetcherGithubOutputs.ts",
    "github:outputs:ai": "ts-node src/scripts/emitAiGithubOutputs.ts",
    "github:outputs:gunner": "ts-node src/scripts/emitGunnerGithubOutputs.ts",
    "queue:health": "ts-node src/scripts/queueHealth.ts",
    "pipeline:batch:verify": "ts-node src/scripts/verifyBatchPipelineReadiness.ts",
    "slack:verify": "ts-node src/scripts/verifySlack.ts",
    "taxonomy:reseed:dry-run": "ts-node src/scripts/reseedTaxonomy.ts --dry-run",
    "taxonomy:reseed": "ts-node src/scripts/reseedTaxonomy.ts --write",
    "taxonomy:reseed:fixtures": "ts-node src/scripts/reseedTaxonomy.ts --write-fixtures",
    "taxonomy:verify": "ts-node src/scripts/verifyTaxonomy.ts",
    "articles:reseed:dry-run": "ts-node src/scripts/reseedArticles.ts --dry-run",
    "articles:reseed": "CONFIRM_SANITY_ARTICLE_RESEED=YES ts-node src/scripts/reseedArticles.ts --write",
    "articles:verify": "ts-node src/scripts/verifyArticles.ts",
    "milestone3:dry-run": "ts-node src/scripts/reseedMilestone3.ts --dry-run",
    "milestone3:reseed": "CONFIRM_SANITY_ARTICLE_RESEED=YES ts-node src/scripts/reseedMilestone3.ts --write",
    "append-tags:migrate:dry-run": "ts-node src/scripts/migrateAppendSeedTags.ts --dry-run",
    "append-tags:migrate": "CONFIRM_SANITY_APPEND_TAG_MIGRATION=YES ts-node src/scripts/migrateAppendSeedTags.ts --write",
    "editorial:append:dry-run": "ts-node src/scripts/appendEditorialArticles.ts --dry-run",
    "editorial:append": "CONFIRM_SANITY_EDITORIAL_APPEND=YES ts-node src/scripts/appendEditorialArticles.ts --write"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@sanity/client": "^7.13.1",
    "@supabase/supabase-js": "^2.108.1",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "cheerio": "^1.1.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
